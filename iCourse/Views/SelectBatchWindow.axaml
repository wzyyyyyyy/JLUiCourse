<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="iCourse.Views.SelectBatchWindow"
        Title="选课批次"
        Height="465"
        Width="600"
        MinHeight="320"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#2E2E2E">
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,2*" Margin="10">
    <ListBox ItemsSource="{Binding BatchList}"
             SelectedItem="{Binding SelectedBatch}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Background="#454545">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding batchName}" Foreground="White" TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ScrollViewer Grid.Column="1"
                  Margin="20,10,0,10"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="轮次码:" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding SelectedBatch.batchId}" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="轮次名:" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding SelectedBatch.batchName}" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="开始时间:" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding SelectedBatch.beginTime}" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="结束时间:" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding SelectedBatch.endTime}" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="选课策略:" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding SelectedBatch.tacticName}" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="不可选原因:" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding SelectedBatch.noSelectReason}" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="选课类型:" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding SelectedBatch.typeName}" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="是否可选:" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding SelectedBatch.canSelect}" Foreground="White" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1"
            Grid.ColumnSpan="2"
            Content="确定"
            Width="100"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Command="{Binding ConfirmSelectionCommand}"
            CommandParameter="{Binding $parent[Window]}" />
  </Grid>
</Window>
